# Qiniu AI is optional. Never commit a real API key.
QINIU_AI_API_KEY=
# Optional default. The frontend can list and select models from Qiniu /v1/models.
QINIU_AI_MODEL=
QINIU_AI_BASE_URL=https://api.qnaigc.com/v1
QINIU_AI_TIMEOUT_SECONDS=90

# Comma-separated origins for separately hosted frontends.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
